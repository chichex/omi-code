{
  "name": "omi-code",
  "version": "0.1.0",
  "private": true,
  "description": "Harness agéntico de codificación e infraestructura para OMI",
  "type": "module",
  "license": "MIT",
  "repository": "https://github.com/chichex/omi-code.git",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "omi": "node bin/omi.ts",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "test:packaging": "OMI_PACKAGING_SMOKE=1 node --test --test-timeout=300000 test/packaging-smoke.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.321",
    "@earendil-works/pi-agent-core": "1.5.1",
    "@earendil-works/pi-ai": "1.5.1",
    "@earendil-works/pi-coding-agent": "1.5.1",
    "@earendil-works/pi-tui": "1.5.1",
    "jiti": "2.7.0",
    "jsonc-parser": "3.3.1",
    "pi-claude-bridge": "0.13.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "typescript": "7.0.2"
  }
}
